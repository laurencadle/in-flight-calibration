def bounds(line, viewing = 30, plotting = 8):
    lower = line - viewing
    upper = line + viewing
    s_low= line - plotting
    s_up = line + plotting
    
    return lower, upper, s_low, s_up

#first fish to fry is the mask, bins, counts, and bin_edges
energy = df['Energy'].to_numpy()

def bin_sorting(N, energy):
    counts, bin_edges = np.histogram(energy, bins=N)
    bin_width = bin_edges[1] - bin_edges[0]
    x = np.linspace(bin_edges[0], bin_edges[-1], N)
    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
    
    return counts, bin_edges, bin_width, x, bin_centers

def slope(d2, d1, y2, y1):
    return (y2 - y1) / (d2 - d1)

def masks(lower, upper, s_low, s_up, bin_centers, energy):
    mask = (energy > lower) & (energy < upper)
    dist = energy[mask]
    peak_mask = (bin_centers > s_low) & (bin_centers < s_up)
    
    return mask, dist, peak_mask

#now lets compress the gaussian plotting function
def gaussian_plot(dist, bin_width):
    def gaussian_scaled(x, mu, sigma, c, d, A):
        return norm.pdf(x, mu, sigma) * (A) * (len(dist) * bin_width) + c * x + d
    return gaussian_scaled
        
#fitting the gaussian to the peak
def fit_peak(gaussian_scaled, line, counts, peak_mask, bin_centers, slope_val, lower, upper, s_low, s_up, x):
    p0_gauss = [line, 2, slope_val, counts[peak_mask].min(), 1000]
    popt_g, pcov_g = curve_fit(gaussian_scaled, bin_centers[peak_mask], counts[peak_mask], p0=p0_gauss, bounds=([s_low, 0.1, -500, -1e6, 0], [s_up, 10, 0, 1e6, np.inf]), maxfev=10000)
    p_err_g = np.sqrt(np.diag(pcov_g))
    x1 = np.linspace(lower, upper, 1001)
    fitted_model_g = gaussian_scaled(x1, *popt_g)
    pdf_gaussian_scaled = gaussian_scaled(x, *popt_g)
    
    return popt_g, pcov_g, p_err_g, x1, fitted_model_g, pdf_gaussian_scaled

def plot_gaussian(line, counts, bin_edges, x1, fitted_model_g, popt_g, lower, upper, s_low, s_up, ylim=(0, 1e5)):
    plt.figure(figsize=(10, 8))
    plt.stairs(counts, bin_edges, fill=True, color='turquoise', edgecolor='black', alpha=0.6, label='Data', linewidth=0.8)
    plt.title(f'Gaussian fit for the {line} keV activation line')
    plt.plot(x1, fitted_model_g, color='mediumvioletred',
              label=f'Gaussian\npeak = {popt_g[0]:.2f}, std = {popt_g[1]:.2f}, c = {popt_g[2]:.2f}, d = {popt_g[3]:.2f}')
    plt.xlabel('Energy')
    plt.ylabel('Counts')
    plt.xlim(lower, upper)
    plt.ylim(*ylim)
    plt.axvspan(s_low, s_up, alpha=0.12, color='grey', label=f'Fit window ({s_low}–{s_up} keV)')
    plt.legend()
    plt.tight_layout()
    plt.show()

