def slope(d2, d1, y2, y1):
    return (y2 - y1) / (d2 - d1)
slope_val = slope(d2, d1, y2, y1)

#define energy lower bounds
#a little dictionary of the lines i need to find soon: {'511': (500, 520),'596': (585, 605),'607': (596, 617),'438': (427, 447),'175': (164, 186),'93': (82, 104)}
lower_bounds = line - 30
upper_bounds = line + 30
slim_lower = line - 8
slim_upper = line + 8

mask = (df['Energy'] > lower_bounds) & (df['Energy'] < upper_bounds)
dist = df['Energy'][mask].to_numpy()

N=2000
counts, bin_edges = np.histogram(df['Energy'], bins=N)
bin_width = bin_edges[1] - bin_edges[0]

x = np.linspace(bin_edges[0], bin_edges[-1], N)

bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
peak_mask = (bin_centers > slim_lower) & (bin_centers < slim_upper)

#gaussian (NOW WITH PCOV/ERRORS)
def gaussian_scaled(x, mu, sigma, c, d, A):
    return norm.pdf(x, mu, sigma) * (A) * (len(dist) * bin_width) + c * x + d

p0_gauss = [line, 2, slope_val, counts[peak_mask].min(),1000]
popt_g, pcov_g = curve_fit(gaussian_scaled, bin_centers[peak_mask], counts[peak_mask], p0=p0_gauss, bounds=([slim_lower, 0.1, -500, -1e6, 0], [slim_upper, 10, 0, 1e6, np.inf]), maxfev=10000)
p_err_g = np.sqrt(np.diag(pcov_g))
x1 = np.linspace(lower_bounds, upper_bounds, 1001)
fitted_model_g = gaussian_scaled(x1, *popt_g)
pdf_gaussian_scaled = gaussian_scaled(x, *popt_g)

#lorentzian
def lorentzian_scaled(x, mu, gamma, c, d, A):
    return cauchy.pdf(x, mu, gamma) * (A) * (len(dist) * bin_width) + c * x + d

p0_lor = [line, 2, slope_val, counts[peak_mask].min(), 1000]
popt_l, pcov_l = curve_fit(lorentzian_scaled, bin_centers[peak_mask], counts[peak_mask], p0=p0_lor, bounds=([slim_lower, 0.1, -500, -1e6, 0], [slim_upper, 10, 0, 1e6, np.inf]), maxfev=10000)
p_err_l = np.sqrt(np.diag(pcov_l))
x2 = np.linspace(lower_bounds, upper_bounds, 1001)
fitted_model_l = lorentzian_scaled(x2, *popt_l)
pdf_lorentzian_scaled = lorentzian_scaled(x, *popt_l)

#hyperbolic
def hyperbolic_pdf(x, mu, scale):
    return (1 / (2 * scale)) * (1 / np.cosh((x - mu) / scale)) ** 2

def hyperbolic_scaled(x, mu, scale, c, d, A):
    return hyperbolic_pdf(x, mu, scale) * (A) * (len(dist) * bin_width) + c * x + d

p0 = [line, 2, slope_val, counts[peak_mask].min(), 1000]
popt, pcov_h = curve_fit(hyperbolic_scaled, bin_centers[peak_mask], counts[peak_mask], p0=p0, bounds=([slim_lower, 0.1, -500, -1e6, 0], [slim_upper, 10, 0, 1e6, np.inf]), maxfev=10000)
p_err_h = np.sqrt(np.diag(pcov_h))
x3 = np.linspace(lower_bounds, upper_bounds, 1001)
fitted_model_h = hyperbolic_scaled(x3, *popt)
pdf_hyperbolic_scaled = hyperbolic_scaled(x, *popt)

