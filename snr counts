line = 511      
N = 2000
detector = 1

energy = df[df['Detector ID'] == detector]['Energy'].to_numpy()

def bounds(line, viewing=30, plotting=8):
    lower = line - viewing
    upper = line + viewing
    s_low = line - plotting
    s_up = line + plotting
    return lower, upper, s_low, s_up

def bin_sorting(N, energy):
    counts, bin_edges = np.histogram(energy, bins=N)
    bin_width = bin_edges[1] - bin_edges[0]
    x = np.linspace(bin_edges[0], bin_edges[-1], N)
    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2
    return counts, bin_edges, bin_width, x, bin_centers

def slope(d2, d1, y2, y1):
    return (y2 - y1) / (d2 - d1)

def masks(lower, upper, s_low, s_up, bin_centers, energy):
    mask = (energy > lower) & (energy < upper)
    dist = energy[mask]
    peak_mask = (bin_centers > s_low) & (bin_centers < s_up)
    return mask, dist, peak_mask

def gaussian_plot(dist, bin_width):
    def gaussian_scaled(x, mu, sigma, c, d, A):
        return norm.pdf(x, mu, sigma) * (A) * (len(dist) * bin_width) + c * x + d
    return gaussian_scaled

def fit_peak(gaussian_scaled, line, counts, peak_mask, bin_centers, slope_val, lower, upper, s_low, s_up, x):
    p0_gauss = [line, 2, slope_val, counts[peak_mask].min(), 1000]
    popt_g, pcov_g = curve_fit(gaussian_scaled, bin_centers[peak_mask], counts[peak_mask], p0=p0_gauss,
                               bounds=([s_low, 0.1, -500, -1e6, 0], [s_up, 10, 0, 1e6, np.inf]), maxfev=10000)
    p_err_g = np.sqrt(np.diag(pcov_g))
    x1 = np.linspace(lower, upper, 1001)
    fitted_model_g = gaussian_scaled(x1, *popt_g)
    pdf_gaussian_scaled = gaussian_scaled(x, *popt_g)
    return popt_g, pcov_g, p_err_g, x1, fitted_model_g, pdf_gaussian_scaled

def snr(popt_g, dist, bin_width):
    mu, sigma, c, d, A = popt_g
    lower = mu - 1.4*sigma
    upper = mu + 1.4*sigma
    h = upper - lower
    S = (norm.cdf(upper, mu, sigma) - norm.cdf(lower, mu, sigma)) * A * len(dist) * bin_width
    B = 1/2 * ((c*lower + d) + (c*upper + d)) * h
    return S / np.sqrt(S + B)

lower, upper, s_low, s_up = bounds(line)
counts, bin_edges, bin_width, x, bin_centers = bin_sorting(N, energy)
slope_val = slope(bin_edges[-1], bin_edges[0], counts[-1], counts[0])
mask, dist, peak_mask = masks(lower, upper, s_low, s_up, bin_centers, energy)
gaussian_scaled = gaussian_plot(dist, bin_width)
popt_g, pcov_g, p_err_g, x1, fitted_model_g, pdf_gaussian_scaled = fit_peak(gaussian_scaled, line, counts, peak_mask, bin_centers, slope_val, lower, upper, s_low, s_up, x)

snr_val = snr(popt_g, dist, bin_width)
print(f"Detector {detector}, {line} keV: SNR = {snr_val:.2f}")
